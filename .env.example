# Supabase (new project — NOT the Dilly V2 project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — agents
ANTHROPIC_API_KEY=
# Model id per tier (use the current ids from docs.claude.com/en/docs/about-claude/models)
DILLY_MODEL_OPUS=
DILLY_MODEL_SONNET=
DILLY_MODEL_HAIKU=

# Inngest (cron + durable agent runs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional reliability knobs (defaults shown). See docs/RUNBOOK.md.
# DILLY_SUPABASE_TIMEOUT_MS=8000
# DILLY_LLM_TIMEOUT_MS=30000
# LOG_LEVEL=info
# SENTRY_DSN=            # TODO: not wired yet (no dependency at launch)

# Gmail sync (optional; hidden until all three are set). See docs/RUNBOOK.md §10.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
MAIL_TOKEN_KEY=

# Web Push reminders (docs/RUNBOOK.md §11). Generate once: npx tsx scripts/gen-vapid.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@dillyos.com

# Photos + business-card scans (docs/RUNBOOK.md §12). Default: Supabase Storage, private bucket "media"
# (created by migration 20261004300000_field_kit.sql). "local" = disk, for dev / e2e only (not Vercel).
# STORAGE_DRIVER=supabase
# STORAGE_LOCAL_DIR=.data/media
# Geocoding for Go → Route and Properties → Nearby (free US Census API, server-side). "off" disables it.
# DILLY_GEOCODER=census
# Address suggestions while typing (docs/RUNBOOK.md §12). Optional: with a key, Google Places API (New) — enable
# "Places API (New)" only and restrict the key to that API. Without it, Photon (free, OSM) is used. Server-side only.
# GOOGLE_MAPS_API_KEY=
# DILLY_ADDRESS_PROVIDER=     # google | photon | off | fake (e2e only). Default: google if the key is set, else photon
